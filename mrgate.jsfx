desc:Mr. Gate
tags:dynamics gate expander

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

slider1:0<0,2,1{Gate,Downward,Upward}>Mode
slider2:0<0,0,1{General}>Style
slider3:-40<-80,0,0.1>Threshold (dB)
slider4:10<1,30,0.1>Ratio
slider5:40<0,60,0.1>Range (dB)
slider6:3<0,24,0.1>Knee (dB)
slider7:1<0.05,100,0.05>Attack (ms)
slider8:100<5,5000,1>Release (ms)
slider9:10<0,250,1>Hold (ms)
slider10:0<0,10,0.1>Lookahead (ms)

@init
// Memory layout:
//   0..1023   : lookahead delay buffer (left)   [Phase 3]
//   1024..2047: lookahead delay buffer (right)  [Phase 3]
//   2048..4095: level history ring buffer (input)   [Phase 6]
//   4096..6143: level history ring buffer (output)  [Phase 6]
//   6144..6175: transfer curve cached points [Phase 5]

LOG2DB = 20 / log(10);
DB2LOG = log(10) / 20;

MODE_GATE = 0;
MODE_DOWN = 1;
MODE_UP   = 2;

TINY = 0.00000000001;

LA_BUF_L    = 0;
LA_BUF_R    = 1024;
LA_BUF_SIZE = 1024;

env_det           = 0;
gain_smooth       = 1.0;
hold_counter      = 0;
direction         = 1;
la_write_pos      = 0;
lookahead_samples = 0;
last_mode         = slider1;  // avoids resetting params on preset load

@slider
mode_id = slider1;

// When mode changes, reload defaults from spec.md defaults table
mode_id != last_mode ? (
  last_mode = mode_id;
  mode_id == MODE_GATE ? (
    slider3 = -40; slider4 = 10; slider5 = 40;
    slider6 = 3;   slider7 = 1;  slider8 = 100;
    slider9 = 10;  slider10 = 0;
  ) : mode_id == MODE_DOWN ? (
    slider3 = -50; slider4 = 2;  slider5 = 12;
    slider6 = 9;   slider7 = 10; slider8 = 250;
    slider9 = 0;   slider10 = 0;
  ) : (
    slider3 = -20; slider4 = 2;  slider5 = 6;
    slider6 = 6;   slider7 = 5;  slider8 = 200;
    slider9 = 0;   slider10 = 0;
  );
  slider_automate(slider3);  slider_automate(slider4);
  slider_automate(slider5);  slider_automate(slider6);
  slider_automate(slider7);  slider_automate(slider8);
  slider_automate(slider9);  slider_automate(slider10);
);

// +1 = downward (Gate/Down): process below threshold
// -1 = upward: process above threshold
direction = mode_id == MODE_UP ? -1 : 1;

threshold_db = slider3;
ratio        = slider4;
range_db     = slider5;
knee_db      = slider6;
attack_ms    = slider7;
release_ms   = slider8;
hold_ms      = slider9;

atk_coeff    = 1 - exp(-log(10) / max(attack_ms  * srate / 1000, 1));
rel_coeff    = 1 - exp(-log(10) / max(release_ms * srate / 1000, 1));
rms_coeff    = 1 - exp(-1 / (0.005 * srate));
hold_samples = floor(hold_ms * srate / 1000);

lookahead_samples = min(floor(slider10 * srate / 1000), LA_BUF_SIZE - 1);
pdc_delay   = lookahead_samples;
pdc_bot_ch  = 0;
pdc_top_ch  = 2;

@sample
// Write current (undelayed) input into lookahead buffer
LA_BUF_L[la_write_pos] = spl0;
LA_BUF_R[la_write_pos] = spl1;

// --- Peak detection (stereo linked) on undelayed signal ---
det = max(abs(spl0), abs(spl1));

// Light pre-smoothing (~5ms) to prevent chatter
env_det += rms_coeff * (det - env_det);

// Convert to dB
env_db = env_det > TINY ? LOG2DB * log(env_det) : -200;

// --- Hold counter ---
env_db >= threshold_db ? (
  hold_counter = hold_samples
) : (
  hold_counter > 0 ? (hold_counter -= 1)
);

// --- Unified gain curve ---
// active > 0: signal is on the processing side of the threshold
// active < 0: signal is on the inactive side (no processing)
// Downward (direction=+1): active = -(env_db - threshold_db), positive below threshold
// Upward   (direction=-1): active =  (env_db - threshold_db), positive above threshold
active = -direction * (env_db - threshold_db);

active < -(knee_db * 0.5) ? (
  // Inactive side, outside knee: no gain change
  target_gain_db = 0
) : knee_db > 0 && active < knee_db * 0.5 ? (
  // Soft knee: quadratic interpolation, C1-continuous at both boundaries
  tmp = active + knee_db * 0.5;
  abs_gain = (ratio - 1) * tmp * tmp / (2 * knee_db);
  abs_gain = min(abs_gain, range_db);
  target_gain_db = -direction * abs_gain
) : (
  // Active side, beyond knee: full expansion or boost
  abs_gain = (ratio - 1) * active;
  abs_gain = min(abs_gain, range_db);
  target_gain_db = -direction * abs_gain
);

target_gain = exp(target_gain_db * DB2LOG);

// Hold: freeze gain during hold period
hold_counter > 0 && target_gain < gain_smooth ? (
  target_gain = gain_smooth
);

// --- Asymmetric attack/release smoothing ---
target_gain > gain_smooth ? (
  gain_smooth += atk_coeff * (target_gain - gain_smooth)
) : (
  gain_smooth += rel_coeff * (target_gain - gain_smooth)
);

// --- Read delayed audio and apply gain ---
read_pos = (la_write_pos - lookahead_samples + LA_BUF_SIZE) % LA_BUF_SIZE;
spl0 = LA_BUF_L[read_pos] * gain_smooth;
spl1 = LA_BUF_R[read_pos] * gain_smooth;

la_write_pos = (la_write_pos + 1) % LA_BUF_SIZE;
