desc:Mr. Gate
tags:dynamics gate expander

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

slider1:0<0,2,1{Gate,Downward,Upward}>Mode
slider2:0<0,0,1{General}>Style
slider3:-40<-80,0,0.1>Threshold (dB)
slider4:10<1,30,0.1>Ratio
slider5:40<0,60,0.1>Range (dB)
slider6:3<0,24,0.1>Knee (dB)
slider7:1<0.05,100,0.05>Attack (ms)
slider8:100<5,5000,1>Release (ms)
slider9:10<0,250,1>Hold (ms)
slider10:0<0,10,0.1>Lookahead (ms)
slider11:20<20,500,1>SC HP (Hz)

@init
// Memory layout:
//   0..1023   : lookahead delay buffer (left)         [Phase 3]
//   1024..2047: lookahead delay buffer (right)        [Phase 3]
//   2048..4095: level history ring buffer (input)     [Phase 6]
//   4096..6143: level history ring buffer (output)    [Phase 6]
//   6144..6175: transfer curve cached points          [Phase 5]
//   6200..6226: mode defaults table (3 modes × 9 params) [Phase 4]
//   6230..6238: slider min table (9 entries)          [Phase 4]
//   6240..6248: slider max table (9 entries)          [Phase 4]

LOG2DB = 20 / log(10);
DB2LOG = log(10) / 20;

MODE_GATE = 0;
MODE_DOWN = 1;
MODE_UP   = 2;

TINY = 0.00000000001;

LA_BUF_L    = 0;
LA_BUF_R    = 1024;
LA_BUF_SIZE = 1024;

env_det           = 0;
vis_meansq          = 0;    // UI-only: slow RMS follower for the live input dot
vis_rms_readout_ms  = 0;    // UI-only: long-window RMS for the readout text
vis_peak_db         = -200; // UI-only: max peak hold for the readout text
sc_hp_state_l = 0;
sc_hp_state_r = 0;
sc_hp_coeff   = 0;          // 0 = bypassed (slider at minimum 20 Hz)
gain_smooth       = 1.0;
hold_counter      = 0;
direction         = 1;
la_write_pos      = 0;
lookahead_samples = 0;
last_mode         = slider1;  // avoids resetting params on preset load

// --- UI layout constants (Phase 4a) ---
gfx_w = 700;
gfx_h = 420;

KNOB_R    = 22;
ANG_MIN   = 2 * $pi / 3;
ANG_SWEEP = 5 * $pi / 3;
KNOB_L_X  = 65;
KNOB_R_X  = 635;
KNOB_Y0   = 87;
KNOB_Y1   = 165;
KNOB_Y2   = 243;
KNOB_Y3   = 321;

DEFAULT_TABLE    = 6200;
SLIDER_MIN_TABLE = 6230;
SLIDER_MAX_TABLE = 6240;

// Gate defaults (indices 0-8: thresh, ratio, range, knee, atk, rel, hold, la, sc_hp)
DEFAULT_TABLE[0]=-40;  DEFAULT_TABLE[1]=10;  DEFAULT_TABLE[2]=40;
DEFAULT_TABLE[3]=3;    DEFAULT_TABLE[4]=1;   DEFAULT_TABLE[5]=100;
DEFAULT_TABLE[6]=10;   DEFAULT_TABLE[7]=0;   DEFAULT_TABLE[8]=20;
// Downward defaults (indices 9-17)
DEFAULT_TABLE[9]=-50;  DEFAULT_TABLE[10]=2;  DEFAULT_TABLE[11]=12;
DEFAULT_TABLE[12]=9;   DEFAULT_TABLE[13]=10; DEFAULT_TABLE[14]=250;
DEFAULT_TABLE[15]=0;   DEFAULT_TABLE[16]=0;  DEFAULT_TABLE[17]=20;
// Upward defaults (indices 18-26)
DEFAULT_TABLE[18]=-20; DEFAULT_TABLE[19]=2;  DEFAULT_TABLE[20]=6;
DEFAULT_TABLE[21]=6;   DEFAULT_TABLE[22]=5;  DEFAULT_TABLE[23]=200;
DEFAULT_TABLE[24]=0;   DEFAULT_TABLE[25]=0;  DEFAULT_TABLE[26]=20;

SLIDER_MIN_TABLE[0]=-80;  SLIDER_MAX_TABLE[0]=0;
SLIDER_MIN_TABLE[1]=1;    SLIDER_MAX_TABLE[1]=30;
SLIDER_MIN_TABLE[2]=0;    SLIDER_MAX_TABLE[2]=60;
SLIDER_MIN_TABLE[3]=0;    SLIDER_MAX_TABLE[3]=24;
SLIDER_MIN_TABLE[4]=0.05; SLIDER_MAX_TABLE[4]=100;
SLIDER_MIN_TABLE[5]=5;    SLIDER_MAX_TABLE[5]=5000;
SLIDER_MIN_TABLE[6]=0;    SLIDER_MAX_TABLE[6]=250;
SLIDER_MIN_TABLE[7]=0;    SLIDER_MAX_TABLE[7]=10;
SLIDER_MIN_TABLE[8]=20;   SLIDER_MAX_TABLE[8]=500;

ui_disp_enabled = 1;

HIST_IN_BUF    = 2048;
HIST_OUT_BUF   = 4096;
HIST_BUF_SIZE  = 2048;
HIST_DISP_SAMP = 1000;  // ~3s window at 3ms resolution

hist_write_pos  = 0;
hist_ds_counter = 0;
hist_ds_rate    = max(1, floor(srate * 0.003));

memset(HIST_IN_BUF,  -200, HIST_BUF_SIZE);
memset(HIST_OUT_BUF, -200, HIST_BUF_SIZE);

@slider
mode_id = slider1;

// When mode changes, reload defaults from spec.md defaults table
mode_id != last_mode ? (
  last_mode = mode_id;
  mode_id == MODE_GATE ? (
    slider3 = -40; slider4 = 10; slider5 = 40;
    slider6 = 3;   slider7 = 1;  slider8 = 100;
    slider9 = 10;  slider10 = 0; slider11 = 20;
  ) : mode_id == MODE_DOWN ? (
    slider3 = -50; slider4 = 2;  slider5 = 12;
    slider6 = 9;   slider7 = 10; slider8 = 250;
    slider9 = 0;   slider10 = 0; slider11 = 20;
  ) : (
    slider3 = -20; slider4 = 2;  slider5 = 6;
    slider6 = 6;   slider7 = 5;  slider8 = 200;
    slider9 = 0;   slider10 = 0; slider11 = 20;
  );
  slider_automate(slider3);  slider_automate(slider4);
  slider_automate(slider5);  slider_automate(slider6);
  slider_automate(slider7);  slider_automate(slider8);
  slider_automate(slider9);  slider_automate(slider10);
  slider_automate(slider11);
);

// +1 = downward (Gate/Down): process below threshold
// -1 = upward: process above threshold
direction = mode_id == MODE_UP ? -1 : 1;

threshold_db = slider3;
ratio        = slider4;
range_db     = slider5;
knee_db      = slider6;
attack_ms    = slider7;
release_ms   = slider8;
hold_ms      = slider9;

atk_coeff    = 1 - exp(-log(10) / max(attack_ms  * srate / 1000, 1));
rel_coeff    = 1 - exp(-log(10) / max(release_ms * srate / 1000, 1));
rms_coeff    = 1 - exp(-1 / (0.005 * srate));
vis_rms_coeff = 1 - exp(-1 / (0.150 * srate));  // ~150ms RMS for the visual dot
vis_rms_readout_coeff = 1 - exp(-1 / (1.0 * srate));  // ~1s RMS for the stable readout
hold_samples = floor(hold_ms * srate / 1000);

lookahead_samples = min(floor(slider10 * srate / 1000), LA_BUF_SIZE - 1);
pdc_delay   = lookahead_samples;
pdc_bot_ch  = 0;
pdc_top_ch  = 2;

// Sidechain highpass: 0 = bypassed when at minimum (20 Hz)
sc_hp_coeff = slider11 > 20.5 ? (1 - exp(-2 * $pi * slider11 / srate)) : 0;

@sample
// Write current (undelayed) input into lookahead buffer
LA_BUF_L[la_write_pos] = spl0;
LA_BUF_R[la_write_pos] = spl1;

// --- Peak detection (stereo linked) with optional sidechain highpass ---
// HP filter is a first-order highpass on the raw audio before rectification.
// sc_hp_coeff == 0 means bypassed (slider at 20 Hz minimum).
sc_hp_coeff > 0 ? (
  sc_hp_state_l += sc_hp_coeff * (spl0 - sc_hp_state_l);
  sc_hp_state_r += sc_hp_coeff * (spl1 - sc_hp_state_r);
  det = max(abs(spl0 - sc_hp_state_l), abs(spl1 - sc_hp_state_r));
) : (
  det = max(abs(spl0), abs(spl1));
);

// Light pre-smoothing (~5ms) to prevent chatter
env_det += rms_coeff * (det - env_det);

// UI-only slow RMS follower (integrate mean-square; log deferred to @gfx)
vis_meansq += vis_rms_coeff * (det * det - vis_meansq);
// UI-only long-window RMS for the readout (settles to a stable average)
vis_rms_readout_ms += vis_rms_readout_coeff * (det * det - vis_rms_readout_ms);

// Convert to dB
env_db = env_det > TINY ? LOG2DB * log(env_det) : -200;

// UI-only max peak hold (true maximum over time)
vis_peak_db = max(vis_peak_db, env_db);

// --- Hold counter ---
env_db >= threshold_db ? (
  hold_counter = hold_samples
) : (
  hold_counter > 0 ? (hold_counter -= 1)
);

// --- Unified gain curve ---
// active > 0: signal is on the processing side of the threshold
// active < 0: signal is on the inactive side (no processing)
// Downward (direction=+1): active = -(env_db - threshold_db), positive below threshold
// Upward   (direction=-1): active =  (env_db - threshold_db), positive above threshold
active = -direction * (env_db - threshold_db);

active < -(knee_db * 0.5) ? (
  // Inactive side, outside knee: no gain change
  target_gain_db = 0
) : knee_db > 0 && active < knee_db * 0.5 ? (
  // Soft knee: quadratic interpolation, C1-continuous at both boundaries
  tmp = active + knee_db * 0.5;
  abs_gain = (ratio - 1) * tmp * tmp / (2 * knee_db);
  abs_gain = min(abs_gain, range_db);
  target_gain_db = -direction * abs_gain
) : (
  // Active side, beyond knee: full expansion or boost
  abs_gain = (ratio - 1) * active;
  abs_gain = min(abs_gain, range_db);
  target_gain_db = -direction * abs_gain
);

target_gain = exp(target_gain_db * DB2LOG);

// Hold: freeze gain during hold period
hold_counter > 0 && target_gain < gain_smooth ? (
  target_gain = gain_smooth
);

// --- Asymmetric attack/release smoothing ---
target_gain > gain_smooth ? (
  gain_smooth += atk_coeff * (target_gain - gain_smooth)
) : (
  gain_smooth += rel_coeff * (target_gain - gain_smooth)
);

// --- Read delayed audio and apply gain ---
read_pos = (la_write_pos - lookahead_samples + LA_BUF_SIZE) % LA_BUF_SIZE;
spl0 = LA_BUF_L[read_pos] * gain_smooth;
spl1 = LA_BUF_R[read_pos] * gain_smooth;

la_write_pos = (la_write_pos + 1) % LA_BUF_SIZE;

hist_ds_counter += 1;
hist_ds_counter >= hist_ds_rate ? (
  hist_ds_counter = 0;
  ui_disp_enabled ? (
    HIST_IN_BUF[hist_write_pos]  = env_db;
    HIST_OUT_BUF[hist_write_pos] = env_db + LOG2DB * log(max(gain_smooth, TINY));
    hist_write_pos = (hist_write_pos + 1) % HIST_BUF_SIZE;
  );
);

@gfx
function ui_draw_knob(cx, cy, r, t)
local(scx, scy, sr, ang, ix, iy)
(
  scx = cx * ui_sx;
  scy = cy * ui_sy;
  sr  = r * min(ui_sx, ui_sy);
  ang = ANG_MIN + t * ANG_SWEEP;

  // Body: filled circle + outline
  gfx_r = 0.200; gfx_g = 0.200; gfx_b = 0.220; gfx_a = 1;
  gfx_circle(scx, scy, sr, 1, 1);
  gfx_r = 0.282; gfx_g = 0.282; gfx_b = 0.314;
  gfx_circle(scx, scy, sr, 0, 1);

  // Full track arc (~3px: drawn at 3 consecutive radii)
  // gfx_arc uses y-up angles and sweeps CW from ang1 to ang2
  gfx_r = 0.228; gfx_g = 0.228; gfx_b = 0.259;
  gfx_arc(scx, scy, sr+4, -ANG_MIN, -(ANG_MIN+ANG_SWEEP), 1);
  gfx_arc(scx, scy, sr+5, -ANG_MIN, -(ANG_MIN+ANG_SWEEP), 1);
  gfx_arc(scx, scy, sr+6, -ANG_MIN, -(ANG_MIN+ANG_SWEEP), 1);

  // Active fill arc
  t > 0 ? (
    gfx_r = 0.228; gfx_g = 0.565; gfx_b = 0.878;
    gfx_arc(scx, scy, sr+4, -ANG_MIN, -ang, 1);
    gfx_arc(scx, scy, sr+5, -ANG_MIN, -ang, 1);
    gfx_arc(scx, scy, sr+6, -ANG_MIN, -ang, 1);
  );

  // Indicator dot on knob face
  ix = scx + (sr - 5) * cos(ang);
  iy = scy + (sr - 5) * sin(ang);
  gfx_r = 0.722; gfx_g = 0.847; gfx_b = 0.973;
  gfx_circle(ix, iy, max(2, 3 * min(ui_sx, ui_sy)), 1, 1);
);

function ui_gain_db(in_db)
local(_act, _tmp, _ag)
(
  _act = -direction * (in_db - threshold_db);
  _act < -(knee_db * 0.5) ? (
    _ag = 0;
  ) : knee_db > 0 && _act < knee_db * 0.5 ? (
    _tmp = _act + knee_db * 0.5;
    _ag = min((ratio - 1) * _tmp * _tmp / (2 * knee_db), range_db);
    _ag = -direction * _ag;
  ) : (
    _ag = min((ratio - 1) * _act, range_db);
    _ag = -direction * _ag;
  );
  _ag
);

// Scale factors
ui_sx = gfx_w / 700;
ui_sy = gfx_h / 420;
ui_fs = min(ui_sx, ui_sy);

// Define fonts each frame, scaled to the window size
gfx_setfont(1, "Arial", max(12, floor(18 * ui_fs)));
gfx_setfont(2, "Arial", max(11, floor(15 * ui_fs)));

disp_x = 130 * ui_sx;
disp_y = 48 * ui_sy;
disp_w = 440 * ui_sx;
disp_h = 312 * ui_sy;

// Normalize slider values to 0..1 for knob drawing
t_thresh = (slider3 + 80) / 80;
t_ratio  = (slider4 - 1) / 29;
t_range  = slider5 / 60;
t_knee   = slider6 / 24;
t_atk    = (slider7 - 0.05) / 99.95;
t_rel    = (slider8 - 5) / 4995;
t_hold   = slider9 / 250;
t_la     = slider10 / 10;
t_sc_hp  = (slider11 - 20) / 480;

// --- Background ---
gfx_r = 0.102; gfx_g = 0.102; gfx_b = 0.118; gfx_a = 1;
gfx_rect(0, 0, gfx_w, gfx_h);

// --- Top bar background ---
gfx_r = 0.133; gfx_g = 0.133; gfx_b = 0.149;
gfx_rect(0, 0, gfx_w, 40*ui_sy);

// Mode button: Gate
bx = 10*ui_sx; by = 8*ui_sy; bw = 62*ui_sx; bh = 24*ui_sy;
gfx_r = 0.267; gfx_g = 0.267; gfx_b = 0.314;
gfx_rect(bx-1, by-1, bw+2, bh+2);
slider1 == 0 ? (gfx_r=0.165; gfx_g=0.424; gfx_b=0.722) : (gfx_r=0.157; gfx_g=0.157; gfx_b=0.180);
gfx_rect(bx, by, bw, bh);
gfx_setfont(1);
slider1 == 0 ? (gfx_r=0.847; gfx_g=0.847; gfx_b=0.863) : (gfx_r=0.533; gfx_g=0.533; gfx_b=0.565);
gfx_measurestr("Gate", str_w, str_h);
gfx_x = bx + (bw-str_w)*0.5; gfx_y = by + (bh-str_h)*0.5;
gfx_drawstr("Gate");

// Mode button: Downward
bx = 78*ui_sx; bw = 86*ui_sx;
gfx_r = 0.267; gfx_g = 0.267; gfx_b = 0.314;
gfx_rect(bx-1, by-1, bw+2, bh+2);
slider1 == 1 ? (gfx_r=0.165; gfx_g=0.424; gfx_b=0.722) : (gfx_r=0.157; gfx_g=0.157; gfx_b=0.180);
gfx_rect(bx, by, bw, bh);
slider1 == 1 ? (gfx_r=0.847; gfx_g=0.847; gfx_b=0.863) : (gfx_r=0.533; gfx_g=0.533; gfx_b=0.565);
gfx_measurestr("Downward", str_w, str_h);
gfx_x = bx + (bw-str_w)*0.5; gfx_y = by + (bh-str_h)*0.5;
gfx_drawstr("Downward");

// Mode button: Upward
bx = 170*ui_sx; bw = 72*ui_sx;
gfx_r = 0.267; gfx_g = 0.267; gfx_b = 0.314;
gfx_rect(bx-1, by-1, bw+2, bh+2);
slider1 == 2 ? (gfx_r=0.165; gfx_g=0.424; gfx_b=0.722) : (gfx_r=0.157; gfx_g=0.157; gfx_b=0.180);
gfx_rect(bx, by, bw, bh);
slider1 == 2 ? (gfx_r=0.847; gfx_g=0.847; gfx_b=0.863) : (gfx_r=0.533; gfx_g=0.533; gfx_b=0.565);
gfx_measurestr("Upward", str_w, str_h);
gfx_x = bx + (bw-str_w)*0.5; gfx_y = by + (bh-str_h)*0.5;
gfx_drawstr("Upward");

// Style label
gfx_r = 0.533; gfx_g = 0.533; gfx_b = 0.565;
gfx_x = 450*ui_sx; gfx_y = 15*ui_sy;
gfx_drawstr("Style:");

// Style dropdown box
bx = 490*ui_sx; by = 8*ui_sy; bw = 200*ui_sx; bh = 24*ui_sy;
gfx_r = 0.267; gfx_g = 0.267; gfx_b = 0.314;
gfx_rect(bx-1, by-1, bw+2, bh+2);
gfx_r = 0.157; gfx_g = 0.157; gfx_b = 0.180;
gfx_rect(bx, by, bw, bh);
gfx_r = 0.847; gfx_g = 0.847; gfx_b = 0.863;
gfx_measurestr("General", str_w, str_h);
gfx_x = bx + (bw-str_w)*0.5; gfx_y = by + (bh-str_h)*0.5;
gfx_drawstr("General");

// --- Display area ---
gfx_r = 0.267; gfx_g = 0.267; gfx_b = 0.314; gfx_a = 1;
gfx_rect(disp_x-1, disp_y-1, disp_w+2, disp_h+2);
gfx_r = 0.039; gfx_g = 0.047; gfx_b = 0.063;
gfx_rect(disp_x, disp_y, disp_w, disp_h);

_vis_rms_db = vis_meansq > TINY ? LOG2DB * 0.5 * log(vis_meansq) : -200;

// Phase 6: Scrolling level history (0 dB at top, -60 dB at bottom)
// Per-pixel peak bucketing: each column takes the peak over the samples it
// covers, which anti-aliases the downsampling and removes scroll shimmer.
ui_disp_enabled ? (
  _disp_w_px = floor(disp_w);
  _bot_y = disp_y + disp_h;
  _aspan = _disp_w_px > 1 ? (HIST_DISP_SAMP - 1) / (_disp_w_px - 1) : 0;
  _half  = _aspan * 0.5;
  _p = 0;
  loop(_disp_w_px,
    _age_c     = (_disp_w_px - 1 - _p) * _aspan;
    _age_start = max(0, floor(_age_c - _half));
    _age_end   = min(HIST_DISP_SAMP - 1, floor(_age_c + _half));
    _in_db = -200; _out_db = -200;
    _a = _age_start;
    loop(_age_end - _age_start + 1,
      _bi = (hist_write_pos + HIST_BUF_SIZE - 1 - _a) % HIST_BUF_SIZE;
      _iv = HIST_IN_BUF[_bi];  _iv > _in_db  ? _in_db  = _iv;
      _ov = HIST_OUT_BUF[_bi]; _ov > _out_db ? _out_db = _ov;
      _a += 1;
    );
    _in_db  = max(-60, min(0, _in_db));
    _out_db = max(-60, min(0, _out_db));
    _px = disp_x + _p;
    _in_y  = disp_y + disp_h * (-_in_db  / 60);
    _out_y = disp_y + disp_h * (-_out_db / 60);
    // Base: lower of input/output filled dark blue
    gfx_r=0.071; gfx_g=0.212; gfx_b=0.392; gfx_a=1;
    gfx_rect(_px, max(_in_y,_out_y), 1, _bot_y - max(_in_y,_out_y));
    // Gain change band: warm red = reduction, teal = boost
    _in_y < _out_y ? (
      gfx_r=0.490; gfx_g=0.200; gfx_b=0.160;
      gfx_rect(_px, _in_y, 1, _out_y - _in_y);
    ) : _out_y < _in_y ? (
      gfx_r=0.160; gfx_g=0.490; gfx_b=0.360;
      gfx_rect(_px, _out_y, 1, _in_y - _out_y);
    );
    _p += 1;
  );
);

// dB grid lines (overlaid on scrolling bars)
gfx_r = 0.180; gfx_g = 0.200; gfx_b = 0.240; gfx_a = 0.8;
_gdb = -10;
loop(5,
  _gy = disp_y + disp_h * (-_gdb / 60);
  gfx_line(disp_x, _gy, disp_x + disp_w, _gy, 0);
  _gdb -= 10;
);

// dB axis labels (left edge of display)
gfx_setfont(2);
gfx_r = 0.380; gfx_g = 0.400; gfx_b = 0.450; gfx_a = 1;
_gdb = -10;
loop(5,
  _gy = disp_y + disp_h * (-_gdb / 60);
  sprintf(#_lbl, "%d", _gdb);
  gfx_measurestr(#_lbl, str_w, str_h);
  gfx_x = disp_x + 3; gfx_y = _gy - str_h * 0.5;
  gfx_drawstr(#_lbl);
  _gdb -= 10;
);

// Phase 5: Transfer curve (both axes: 0 dB at top, -60 dB at bottom)
// Unity reference line (45 degree diagonal)
gfx_r = 0.180; gfx_g = 0.200; gfx_b = 0.240; gfx_a = 1;
gfx_line(disp_x, disp_y + disp_h, disp_x + disp_w, disp_y, 1);

// Threshold reference line (vertical)
_thr_x = disp_x + disp_w * max(0, min(1, (threshold_db + 60) / 60));
gfx_r = 0.220; gfx_g = 0.250; gfx_b = 0.300;
gfx_line(_thr_x, disp_y, _thr_x, disp_y + disp_h, 1);

// Range reference line (dashed, parallel to unity, displaced by range_db)
// Downward: output = input - range_db  |  Upward: output = input + range_db
gfx_r = 0.300; gfx_g = 0.200; gfx_b = 0.400; gfx_a = 1;
direction == 1 ? (
  _rng_x1 = disp_x + disp_w * min(1, range_db / 60);
  _rng_y1 = disp_y + disp_h;
  _rng_x2 = disp_x + disp_w;
  _rng_y2 = disp_y + disp_h * min(1, range_db / 60);
) : (
  _rng_x1 = disp_x;
  _rng_y1 = disp_y + disp_h * max(0, (60 - range_db) / 60);
  _rng_x2 = disp_x + disp_w * max(0, (60 - range_db) / 60);
  _rng_y2 = disp_y;
);
_rdx = _rng_x2 - _rng_x1; _rdy = _rng_y2 - _rng_y1;
_rlen = sqrt(_rdx * _rdx + _rdy * _rdy);
_rlen > 0 ? (
  _rnx = _rdx / _rlen; _rny = _rdy / _rlen;
  _rt = 0;
  loop(floor(_rlen / 10) + 1,
    _rt1x = _rng_x1 + _rt * _rnx; _rt1y = _rng_y1 + _rt * _rny;
    _rt2 = min(_rt + 6, _rlen);
    gfx_line(_rt1x, _rt1y, _rng_x1 + _rt2 * _rnx, _rng_y1 + _rt2 * _rny, 1);
    _rt += 10;
  );
);

// Curve polyline: 100 steps from -60 to 0 dB
gfx_r = 0.400; gfx_g = 0.700; gfx_b = 0.950; gfx_a = 1;
_in_db_c = -60;
_out_db_c = max(-60, min(0, _in_db_c + ui_gain_db(_in_db_c)));
gfx_x = disp_x;
gfx_y = disp_y + disp_h * (-_out_db_c / 60);
loop(99,
  _in_db_c += 60 / 99;
  _out_db_c = max(-60, min(0, _in_db_c + ui_gain_db(_in_db_c)));
  _cx = disp_x + disp_w * (_in_db_c + 60) / 60;
  _cy = disp_y + disp_h * (-_out_db_c / 60);
  gfx_lineto(_cx, _cy, 1);
);

// Live input dot on curve — slow RMS level (pre-computed above)
_dot_in  = max(-60, min(0, _vis_rms_db));
_dot_out = max(-60, min(0, _dot_in + ui_gain_db(_dot_in)));
_dot_x = disp_x + disp_w * (_dot_in  + 60) / 60;
_dot_y = disp_y + disp_h * (-_dot_out / 60);
gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_a = 1;
gfx_circle(_dot_x, _dot_y, 4, 1, 1);
gfx_r = 0.100; gfx_g = 0.120; gfx_b = 0.160;
gfx_circle(_dot_x, _dot_y, 4, 0, 1);

// PK and RMS readouts (top-right of display)
gfx_setfont(2);
gfx_r = 0.580; gfx_g = 0.630; gfx_b = 0.710; gfx_a = 1;
vis_peak_db > -190 ? (
  sprintf(#_pkstr, "PK %.1f", max(-60.0, vis_peak_db));
) : (
  sprintf(#_pkstr, "PK ---");
);
gfx_measurestr(#_pkstr, str_w, str_h);
gfx_x = disp_x + disp_w - str_w - 4; gfx_y = disp_y + 4;
gfx_drawstr(#_pkstr);

_vis_rms_rd_db = vis_rms_readout_ms > TINY ? LOG2DB * 0.5 * log(vis_rms_readout_ms) : -200;
_vis_rms_rd_db > -190 ? (
  sprintf(#_rmsstr, "RMS %.1f", max(-60.0, _vis_rms_rd_db));
) : (
  sprintf(#_rmsstr, "RMS ---");
);
gfx_measurestr(#_rmsstr, str_w, str_h);
gfx_x = disp_x + disp_w - str_w - 4; gfx_y = disp_y + 4 + str_h + 2;
gfx_drawstr(#_rmsstr);

// --- Left column knobs ---
gfx_setfont(1);
gfx_r = 0.533; gfx_g = 0.533; gfx_b = 0.565;

ui_draw_knob(KNOB_L_X, KNOB_Y0, KNOB_R, t_thresh);
gfx_measurestr("THRESHOLD", str_w, str_h);
gfx_x = KNOB_L_X*ui_sx - str_w*0.5; gfx_y = (KNOB_Y0+KNOB_R+5)*ui_sy;
gfx_drawstr("THRESHOLD");

ui_draw_knob(KNOB_L_X, KNOB_Y1, KNOB_R, t_ratio);
gfx_measurestr("RATIO", str_w, str_h);
gfx_x = KNOB_L_X*ui_sx - str_w*0.5; gfx_y = (KNOB_Y1+KNOB_R+5)*ui_sy;
gfx_drawstr("RATIO");

ui_draw_knob(KNOB_L_X, KNOB_Y2, KNOB_R, t_range);
gfx_measurestr("RANGE", str_w, str_h);
gfx_x = KNOB_L_X*ui_sx - str_w*0.5; gfx_y = (KNOB_Y2+KNOB_R+5)*ui_sy;
gfx_drawstr("RANGE");

ui_draw_knob(KNOB_L_X, KNOB_Y3, KNOB_R, t_knee);
gfx_measurestr("KNEE", str_w, str_h);
gfx_x = KNOB_L_X*ui_sx - str_w*0.5; gfx_y = (KNOB_Y3+KNOB_R+5)*ui_sy;
gfx_drawstr("KNEE");

// --- Right column knobs ---
ui_draw_knob(KNOB_R_X, KNOB_Y0, KNOB_R, t_atk);
gfx_measurestr("ATTACK", str_w, str_h);
gfx_x = KNOB_R_X*ui_sx - str_w*0.5; gfx_y = (KNOB_Y0+KNOB_R+5)*ui_sy;
gfx_drawstr("ATTACK");

ui_draw_knob(KNOB_R_X, KNOB_Y1, KNOB_R, t_rel);
gfx_measurestr("RELEASE", str_w, str_h);
gfx_x = KNOB_R_X*ui_sx - str_w*0.5; gfx_y = (KNOB_Y1+KNOB_R+5)*ui_sy;
gfx_drawstr("RELEASE");

ui_draw_knob(KNOB_R_X, KNOB_Y2, KNOB_R, t_hold);
gfx_measurestr("HOLD", str_w, str_h);
gfx_x = KNOB_R_X*ui_sx - str_w*0.5; gfx_y = (KNOB_Y2+KNOB_R+5)*ui_sy;
gfx_drawstr("HOLD");

ui_draw_knob(KNOB_R_X, KNOB_Y3, KNOB_R, t_la);
gfx_measurestr("LOOKAHEAD", str_w, str_h);
gfx_x = KNOB_R_X*ui_sx - str_w*0.5; gfx_y = (KNOB_Y3+KNOB_R+5)*ui_sy;
gfx_drawstr("LOOKAHEAD");

// --- Bottom bar ---
// Display toggle button
bx = 10*ui_sx; by = 370*ui_sy; bw = 120*ui_sx; bh = 30*ui_sy;
gfx_r = 0.267; gfx_g = 0.267; gfx_b = 0.314;
gfx_rect(bx-1, by-1, bw+2, bh+2);
ui_disp_enabled ? (gfx_r=0.165; gfx_g=0.424; gfx_b=0.722) : (gfx_r=0.157; gfx_g=0.157; gfx_b=0.180);
gfx_rect(bx, by, bw, bh);
ui_disp_enabled ? (
  gfx_r=0.847; gfx_g=0.847; gfx_b=0.863;
  gfx_measurestr("Display ON", str_w, str_h);
  gfx_x = bx + (bw-str_w)*0.5; gfx_y = by + (bh-str_h)*0.5;
  gfx_drawstr("Display ON");
) : (
  gfx_r=0.533; gfx_g=0.533; gfx_b=0.565;
  gfx_measurestr("Display OFF", str_w, str_h);
  gfx_x = bx + (bw-str_w)*0.5; gfx_y = by + (bh-str_h)*0.5;
  gfx_drawstr("Display OFF");
);

// SC HP knob — centered between display toggle and GR readout
// ui_draw_knob applies ui_sx/ui_sy internally, so pass layout coords directly
_schp_cx = 350*ui_sx; _schp_cy = 385*ui_sy; _schp_r = 14*min(ui_sx,ui_sy);
gfx_setfont(2);
gfx_r = 0.533; gfx_g = 0.533; gfx_b = 0.565;
ui_draw_knob(350, 385, 14, t_sc_hp);
gfx_measurestr("SC HP", str_w, str_h);
gfx_x = _schp_cx - str_w*0.5; gfx_y = _schp_cy - _schp_r - str_h - 2;
gfx_drawstr("SC HP");
slider11 > 20.5 ? (
  sprintf(#_schpv, "%d Hz", floor(slider11));
) : (
  sprintf(#_schpv, "off");
);
gfx_measurestr(#_schpv, str_w, str_h);
gfx_x = _schp_cx - str_w*0.5; gfx_y = _schp_cy + _schp_r + 2;
gfx_drawstr(#_schpv);

// GR readout
bx = 545*ui_sx; bw = 145*ui_sx;
gfx_r = 0.267; gfx_g = 0.267; gfx_b = 0.314;
gfx_rect(bx-1, by-1, bw+2, bh+2);
gfx_r = 0.157; gfx_g = 0.157; gfx_b = 0.180;
gfx_rect(bx, by, bw, bh);
_gr_db = LOG2DB * log(max(gain_smooth, TINY));
_gr_db < -0.05 ? (
  gfx_r = 0.800; gfx_g = 0.500; gfx_b = 0.350;
  sprintf(#_grstr, "GR %.1f dB", _gr_db);
) : _gr_db > 0.05 ? (
  gfx_r = 0.350; gfx_g = 0.750; gfx_b = 0.550;
  sprintf(#_grstr, "GR +%.1f dB", _gr_db);
) : (
  gfx_r = 0.533; gfx_g = 0.533; gfx_b = 0.565;
  sprintf(#_grstr, "GR 0.0 dB");
);
gfx_measurestr(#_grstr, str_w, str_h);
gfx_x = bx + (bw-str_w)*0.5; gfx_y = by + (bh-str_h)*0.5;
gfx_drawstr(#_grstr);
